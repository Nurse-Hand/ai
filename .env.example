# 업무/인수인계 AI 판단 로직
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INTERNAL_API_TOKEN=

# 음성 분석 (STT + 화자분리)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ko-KR
PYANNOTE_AUTH_TOKEN=
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MATCH_THRESHOLD=0.7
TOP_K_DEFAULT=3
MIN_SEGMENT_SEC=0.8
MIN_SPEAKER_TOTAL_SEC=1.2

# 경로/기타
DATA_DIR=./data
TMP_DIR=./tmp
FFMPEG_BIN=ffmpeg
KEEP_UPLOADS=false
