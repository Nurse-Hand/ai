# 업무/인수인계 AI 판단 로직
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
INTERNAL_TOKEN=
CORS_ALLOWED_ORIGINS=

# 음성 분석 (STT + 화자분리)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=ko-KR
PYANNOTE_AUTH_TOKEN=
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MATCH_THRESHOLD=0.7
TOP_K_DEFAULT=3
MIN_SEGMENT_SEC=0.8
MIN_SPEAKER_TOTAL_SEC=1.2
AUDIO_MAX_UPLOAD_BYTES=26214400
AUDIO_MAX_REQUEST_BYTES=27262976
AUDIO_PROCESSING_TIMEOUT_SECONDS=120
AUDIO_CLEANUP_ATTEMPTS=3
AUDIO_WORKER_CAPACITY=4

# 경로/기타
DATA_DIR=./data
TMP_DIR=./tmp
FFMPEG_BIN=ffmpeg
KEEP_UPLOADS=false
