            "title": "Evidencesourceids",
            "type": "array"
          },
          "reasons": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1F\\x7F]*$",
              "type": "string"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Reasons",
            "type": "array"
          },
          "suggestedPriority": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "NORMAL"
            ],
            "title": "Suggestedpriority",
            "type": "string"
          }
        },
        "required": [
          "candidateKey",
          "suggestedPriority",
          "reasons",
          "confidence",
          "evidenceSourceIds"
        ],
        "title": "TaskPrioritySuggestion",
        "type": "object"
      },
      "TimelineEvent": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "occurredAt": {
            "format": "date-time",
            "title": "Occurredat",
            "type": "string"
          },
          "sourceReference": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$",
            "title": "Sourcereference",
            "type": "string"
          },
          "summary": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$",
            "title": "Summary",
            "type": "string"
          },
          "type": {
            "enum": [
              "OBSERVATION",
              "MEDICATION",
              "PROCEDURE",
              "REPORT",
              "TASK"
            ],
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "occurredAt",
          "type",
          "summary",
          "sourceReference"
        ],
        "title": "TimelineEvent",
        "type": "object"
      }
    },
